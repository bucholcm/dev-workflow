# ── Linear (planning source of truth) ──
LINEAR_API_KEY=
LINEAR_TEAM_ID=
# Workflow state IDs are discovered via the API when LINEAR_TEAM_ID is set.

# ── Bitbucket (App Password, scope "Pull requests: Write") ──
# If left blank, these are loaded (like bin/bb) from:
#   ~/.config/bridge-ai/bitbucket.env  →  ~/.zshrc `export BITBUCKET_(USERNAME|TOKEN)=`
BITBUCKET_WORKSPACE=
BITBUCKET_REPO=
BITBUCKET_USERNAME=
BITBUCKET_TOKEN=

# ── Agent models (NEVER hardcoded) ──
MODEL_SIMPLE_IMPLEMENTATION=codex-5.4
MODEL_COMPLEX_IMPLEMENTATION=opus-4.8
MODEL_REVIEW=codex-5.5

# Which CLI drives each logical model: "claude" | "codex"
CLI_FOR_SIMPLE=codex
CLI_FOR_COMPLEX=claude
CLI_FOR_REVIEW=codex
CODEX_FALLBACK_TO_CLAUDE=true

# ── Runtime ──
TARGET_REPO_PATH=/path/to/checkout
RUNS_DIR=runs
LOG_LEVEL=info
DRY_RUN=true
AGENT_TIMEOUT_SECONDS=900

# ── Session radar ("needs your attention" over all Claude sessions) ──
# CLAUDE_PROJECTS_DIR defaults to ~/.claude/projects when blank.
CLAUDE_PROJECTS_DIR=
SESSION_IDLE_SECONDS=45              # newer than this = "running"
SESSION_WAITING_MAX_AGE_SECONDS=172800  # pending turns older than this (2d) aren't "waiting on you"
